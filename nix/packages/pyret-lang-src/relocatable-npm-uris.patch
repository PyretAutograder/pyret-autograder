+# A module's uri is its cache identity: uri-to-path hashes it, and compiled
+# artifacts are filed under that hash. A file-locator derives its uri from the
+# realpath'd absolute path, so artifacts compiled in one tree can never be
+# reused from another -- which defeats --compiled-read-only-dir for anything
+# shipped as a package. A logical root pairs the directory a package resolves
+# to with a stable uri prefix for it, so every file underneath gets an identity
+# that depends on its position in the package rather than on the machine.
+# This is the same move url-file already makes when it overrides uri() with the
+# url a locally-cached file came from.
+data LogicalRoot:
+  | logical-root(real :: String, uri :: String)
+end
