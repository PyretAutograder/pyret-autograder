+fun context-logical(ctxt :: CLIContext) -> Option<LogicalRoot>:
+  if has-field(ctxt, "logical"): ctxt.logical else: none end
+end
+
+# A logical root is absolute on both sides, so descending into subdirectories
+# does not change it -- only entering another package does. Files that resolve
+# outside the current package (none) keep their absolute file:// identity.
+fun logical-uri-for(ctxt :: CLIContext, real-path :: String) -> Option<String>:
+  cases(Option) context-logical(ctxt):
+    | none => none
+    | some(lr) =>
+      prefix = lr.real + "/"
+      if string-starts-with(real-path, prefix):
+        rest = string-substring(real-path, string-length(lr.real), string-length(real-path))
+        some(lr.uri + rest)
+      else:
+        none
+      end
+  end
+end
